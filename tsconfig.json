{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@rulecms/widget-react/server": [
        "node_modules/@rulecms/widget-react/dist/server.d.ts"
      ]
    },
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["./src"]
}
